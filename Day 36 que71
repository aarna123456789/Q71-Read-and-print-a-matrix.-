#include<stdio.h>
int main()
{
int a[10][10],r,c,i,j;
printf("enter rows and columns ");
scanf("%d%d",&r,&c);
printf("enter matrix element");
for(i=0;i<r;i++)
{  
  for(j=0;j<c;j++)
    scanf("%d",&a[i][j]);
}
printf("matrix is");
for(i=0;i<r;i++)
{
  for(j=0;j<c;j++)
    printf("%d",a[i][j]);
  printf("\n");
}
return 0;
}
